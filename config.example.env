# Copy to config.env (gitignored) and fill in. Same values as BACKEND_URL and
# BACKEND_TOKEN in the firmware's include/credentials.h.
FLUXIO_BACKEND_URL=https://your-backend-url/api/devices
FLUXIO_BACKEND_TOKEN=your_api_token_here

# Must match ^esp32_[0-9A-F]{12}$, or the Fluxio app refuses to register it.
FLUXIO_DEVICE_ID=esp32_C209DAB7022B

# Optional
# FLUXIO_FW_VERSION=0.1.0
# FLUXIO_IO_SOURCE=random
# FLUXIO_LOG_LEVEL=INFO
