# Copy to /etc/fluxio/wifi-portal.env on the board (root only, chmod 600).
FLUXIO_DEVICE_ID=esp32_C209DAB7022B

# WPA2 password of the fallback access point (8 to 63 characters). The
# access point SSID is Fluxio-<last 4 characters of the device ID>.
FLUXIO_AP_PASSWORD=change_me_please

# Optional
# FLUXIO_WIFI_IFACE=wlan0
# FLUXIO_WIFI_GRACE_S=60
# FLUXIO_WIFI_AP_WINDOW_S=120
# FLUXIO_WIFI_CLIENT_RETRY_S=30
# FLUXIO_PORTAL_PORT=80
# Seconds the setup page stays reachable on the regular network after start
# and after joining a network through it: 0 = access point only, inf = always.
# FLUXIO_PORTAL_LAN_S=600
# FLUXIO_LOG_LEVEL=INFO
